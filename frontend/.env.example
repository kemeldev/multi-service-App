# Port the dev server binds to
APP_PORT=5173

# Backend base URLs. These are baked in at BUILD time (Vite), so rebuild after
# changing them. Use the IP/hostname the BROWSER can reach - not "localhost"
# if you open the UI from another machine.
VITE_PY_API=http://localhost:8001
VITE_NODE_API=http://localhost:8002

# UI poll interval (ms)
VITE_POLL_MS=5000
