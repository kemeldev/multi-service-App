# ---- this service ----------------------------------------------------
SERVICE_NAME=fastapi-service
APP_PORT=8001
HEARTBEAT_SECONDS=10
# Comma separated. Use * only for local testing.
CORS_ORIGINS=*

# ---- postgres (FILL THESE IN WHEN THE DB IS READY) -------------------
DB_HOST=ubuntuserver1.ssa.veeam.local
DB_PORT=5432
DB_NAME=testdb
DB_USER=testuser
DB_PASSWORD=<ask-for-it>   # real value goes in .env, which is gitignored
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=3
